APP_PORT=8080
# postgres | memory (memory = local demo with seeded synthetic accounts)
STORE=postgres
DB_DSN=postgres://app_user:dev_only_password@localhost:55432/app?sslmode=disable
TEST_DB_DSN=postgres://app_user:dev_only_password@localhost:55432/app_test?sslmode=disable
# Dev only. Production verifies IdP-issued RS256 tokens instead.
JWT_SECRET=CHANGE_ME_local_dev_secret_min_32_bytes
JWT_ISSUER=go-engineering-starter-dev
LOG_LEVEL=info
REQUEST_TIMEOUT=5s
